; commands.xon -- the commands the image has that are a lang of their own.
;
; (command NAME LANG): /bin/NAME starts LANG.  A name with no row here is a
; x-coreutils applet when x-coreutils has one by that name, and is otherwise
; not a command.  A row wins over an applet of the same name.
;
; (command NAME LANG "ENTRY") starts LANG at init/ENTRY instead of at the
; lang's own entry, which finds the command's name in %command.
;
; init and the power commands are not here: they are this repository's own
; programs, run on a lang's state image (see the Dockerfile).

(command sh      ash)
(command ash     ash)
(command grep    grep)
(command sed     sed)
(command awk     awk)
(command cc      cc)
(command python  python)
(command logo    logo)
(command make    make "make.x")
(command infocom infocom)
(command sshd        ssh "ssh.x")
(command ssh         ssh "ssh.x")
(command ssh-keygen  ssh "ssh.x")
(command scp         ssh "ssh.x")
(command sftp        ssh "ssh.x")
(command sftp-server ssh "ssh.x")
(command ssh-agent   ssh "ssh.x")
(command ssh-add     ssh "ssh.x")
(command git              git "git.x")
(command git-upload-pack  git "git.x")
(command git-receive-pack git "git.x")
(command tmux             tmux "tmux.x")
(command links            links "links.x")
