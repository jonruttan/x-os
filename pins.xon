; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "930be02d9a5a4434f309066148fad7d7c9dd3204") ; feat/linux-arm, past v0.46.0 until the release that carries it
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "958230f05e81b99340ebc0832accad250f392d82") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "ff886f381d69d071195245660a0a28ff6c90ddba") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "ddcdb35e3e49a91805d0f90970866657ea0aa8c7") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "2f0d1df030f48f3e970aeec0c7113b4a4eca8c95") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "547152f8378160864543652b8b68aa905b4c1673") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "c99de3036ee9a8fe28b9bad299b4d00df7e1949d") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "3db95ca2643cb16bd06d68bb5521db42526c7118") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "602aa27002edddf1cf3c80a1da04fab8f3207bb7") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "cb78b510b50714ff3aaef9337407f06d8c9f0a15") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "8ac3f91e1799c66e6a6a775dafa82980320de3f7") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "436974b1966d1d9367aa8d5fdd181dd452f382bc") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "a5128d1a98165e2c46dcccfc7a660fa220ac1e38") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "a83488eeb3df6172d19e2d50d26047223f3bca92") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "309778c8a3206e90620dfab88961c0b1cd0f5016") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "d5d4a545d2f44e3d42e419a00ea3ed481ab8b3c9") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "c832aaedf405c1497b3687aa6020a4dd3b5cc719") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
