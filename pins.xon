; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "1dc3f9cb58d06fa819ba48574eee375543520905") ; v0.31.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "20f34042122c938786993e5d3cb4b6309a9ba7e6") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "d9b65a4c343ac0352886f312c2f86f0309910f54") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "aba8293863b4720e4abf7ef102677fa982896ec2") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "3e8ef7e6262f0020b5a2f8648b18aee1c7ee08bf") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "82bd36c28ed8a5db94822e96133066a69079d2c2") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "e532c142909179b7e471b407757fa6081d509aec") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "afdea76d1ec494160d3711abe5452eff2bc7974c") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "e7978897119d3de396cee20c07f7387d15c26a92") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "4004c1c1551ea7d6adf242663aafd9f5ba93cda9") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "ebbdc7176ae84ae0b7c69bf7e4d8405180a34888") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "273950e0556215f9bb7e6e34aaa1f50f4d222deb") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "618b1d70779de5e2be51a7022ed1571a0040957a") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
