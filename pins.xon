; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "31bcee8c65a6100f3541363720e658e6b32e2346") ; v0.39.1
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "de303b4c99026db502520faeedc29ba68071295c") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "ca635f5cd5fbb8d2fc75dd890fcda5ae143d7c5b") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "8c61404b2650e27a2e48cb82bb99a182ef8fb36e") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "40ac847b59856cf80c0c643f97d7293918d97eb1") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "b41f975fa01a502cdda9090f5d44fdbeaa0857ee") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "6c431fcfb0560bf6a5ca769ce63adc402d02053a") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "08b3535ecaa7a23a526ac29084095aed55fd135c") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "a53756c6be43f3365bc22ee2cb57bf700ad109a8") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "0bd79f4745ecc4897d4577cf201ecda8ce333b0c") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "29de7a991fecb9e4b5202888e1e655693c8c19d0") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "44bb80b3855caa1d11781444048a03b005a1482a") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "790808a1bdcc674606c050df8fb4e0d1dad78892") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "1c65c968b4d7e2c2f4b79ae260efcecda47540fa") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
