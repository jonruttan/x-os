; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "03c1278edecb5fc6197dbedf29c39e06422650b2") ; v0.19.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "e3e1651fdde7e849cd653eaee9d714e3617d8db4") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "bcd79fc3d44482351857637f4338f002eac1f9a5") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "3c300115dd3af8f15cac8ec39b235b68516c7075") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "7336c1a5703c5eefeeb52a675983337dba16a53d") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "383e9082f3b17125fcc78837bf61c12b8d94fe3c") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "ae604d5b8dd20765ead7a2ec08657ade6f1d03e8") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "b8b00f990006965639b6424e6e28bba1d5a8d360") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "2ff6c555b509e35e6f0e7c75bcec9091a5bbb543") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "205cf655bf407999479e81e3490eaf327ded0b15") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
