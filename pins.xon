(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "123308f12dad03ee238e53f49f97568c590eb3b6") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "70ca9e69ff820d706df23ec4fbe1d9cf199b5a3a") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "9b4f393916c5347c4733da092c5ce069eea492d2") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "bf310a9eeb71e8022cb9c1a5c994f9d28bc3a221") ; main
