; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "1234c0b535b0f087ef6e673546e165564accd1c0") ; v0.25.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "fc638735cb06779cb096784df30206c73c2d1bb5") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "837ca19f48f9938509574ef10abc5e24c48bb55b") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "e8f1dce2e19d2efda3aacc5ff9330ef14b433061") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "35a9437feb485e3997b11fdeb72e7fc993f16619") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "0a11141a6ad67c8c4a5da4e2a3c9be878d402668") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "48325dafb5b4e6a017ba8fa8ff51c0044abbdd86") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "7f61438a8332187b58331ecbe1b8fc81527014b6") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "cfcd9bc671d62d68aee46634d38968c787250ff0") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "7a1c4a8f327687167b50b733083fbc6629dc31a8") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
