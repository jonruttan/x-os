; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "9543760f5a90ddb1a12d6874c1a90757a4bd2893") ; v0.32.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "e44d53cc6830ef42ee3f91f502363ebabbbc9110") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "00b8b1169cafe408dd6d943237dd1e7799be068b") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "3e3c6456ddbd9ba8607414bf85976449593f9721") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "5a9bc8bb9ed3a273bdb2998118a3eec435cf747d") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "da615a36e7c6608bbbd1ccd921528f200b9de8cd") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "6b7bd8088be7714b86931f80be7f39c8e57d94b2") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "fbe583b36f1cf9a88256655e54871ffa9003e50e") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "a39c08a37313fef54fcd0cacc9b8de603766139e") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "8ad9e3caff281c828aca7bd538778751e36e1ecf") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "8b78fb24be8c01d2cd8ead21b0ba9925735efe79") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "69bb7acb9ec5e13bae1af6bcd974b0dd4d0bbc64") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "a91fa1c1cccd372784abb91e77167cab20816601") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
