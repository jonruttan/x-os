; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "ba925a48c56788efa52ebd04b6d06ba39302a6d7") ; v0.57.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "270010718b4be55043abedf072a00113503d83bd") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "e2f011c1ce0e045cee9c82e84beda28a17605edd") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "e72c1954a237a2e31aa85dccd8c612a85efc99a7") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "18441a2bf0580a69082e50b2489c2a4eab8e6243") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "ba0e3e64a62eef125cdc265347d497255816d911") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "f5ad6bcb14f3ab4126118dc85eda440bb34ad2d7") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "800e41b43c58d092e03cd78494851fe6e43ef65c") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "062026c5d14fc664c63cb9d89989ecf9c3c4b9de") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "5a827f38e223863060d1c6b89ffab4d3e1fab914") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "a5175d50e1ca79f2218b12ed731567c6d4755c3d") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "444bd280347baaf9cadd5a363b8a1a8d0e31ce38") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "fd399d8edbb3277ba6b673df4fa0f643027aa048") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "a28e5bf308c9078c1fa36a30a75954d4da6abc01") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "c11f4356015cef060d6167626e5590b72bca62fd") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "f40dcf66072c9be6353350fda4ede3ebaccfbd5d") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "29b5d4f8860bebc4512208697d352bbd0096f4bb") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
