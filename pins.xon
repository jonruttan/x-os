; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "e1fd08b1cf4d6e02f83bae326faa1301857361ec") ; v0.18.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "b82d200cbee8bcc97b155967d8fd39787e0272e7") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "bd6384bc9989af99ac5d790392291546044f7919") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "21b5c71186a774aa85d04ae99f6e54650a31288d") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "d56c20a797ad066caa0a2e63b3735a795b9b5812") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "c866e67efd4cef13ef48e2e17bdbe8cfd6e1ebae") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "71372155e07548eba7b6824ee7681c071555a2fc") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "8f39d4462085db75d7746fbb6673709ef825f0be") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "1ff710b2fd4443de4c8ae9c654cfacae1a1b81db") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "1ad9efe50542de901f66405dbbeffd09f092d04c") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
