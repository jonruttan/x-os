; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "9f671b798f65e808de824a2e198faf1a686ced67") ; v0.26.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "da12a7f17121f8cfe687ccf3b112c790cdafa7d3") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "95d5f0f0172500b79adcb998b24f4e4f99665599") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "7169fb07282b288814adeeec444e683ae15df210") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "fcef5570e2fe9124606656d6256969ee1fcadaab") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "98c3d6c11ad8afb2a37cdeda62d9cd025d85f380") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "53324769ff9944028bcc9164ade9382a61172481") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "707ad1fd293b26826f66fa0bda7d9b39575d64a8") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "8d93af1c0f6d0a4bbe11e20186f7177f9cdd3600") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "7a29494a4266f63a6525c01ae5984c4544477858") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "f8645e5f0e2e6612fffa0039508542544b3017d9") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
