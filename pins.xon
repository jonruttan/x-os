; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "8affe65025c0191de8582eeca49a34cc6dcbf7d5") ; v0.28.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "d35aed0e0dd75bfa0efc7dbb63fe4be95a0c8ec6") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "0c09e4fe39df721f67e60886982c735542c7030b") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "7169fb07282b288814adeeec444e683ae15df210") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "fcef5570e2fe9124606656d6256969ee1fcadaab") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "352acec1d4252cf5a44601afba01cc971be18019") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "5ff5651afbd3a02dcee6fb63e6ee64b385ed37e1") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "759f51724eae5750b8349c36c357bd4d64ffc0ed") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "c681fb735ba7858e64dbb3b830099c74d9b9f6a0") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "3666c52c90e2c19dc55e9e35319422782ea2c567") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "c2c6eb97fa90e2d2f904487c4fa51cda0fb8dc04") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
