; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "aa315b1c374a69b5d555817159ff6a389ae04457") ; v0.23.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "75713b4711de17d97714ff39e247bd55e6d0e7f3") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "bfb7df7124d4c03c6b888dc015a4a90028b4136e") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "bfd9f9a92f4cb775d69b4c998d13ed182fccd8b7") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "020c5dd7a4ea5b70d19ae4d769521e366152f8f5") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "24d68cada133d30bce7d394b3f45797942b957f3") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "b0d87bae6ab002c1a1db828d694d3c2e07539ee3") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "11b9dcd94346d66de5492b902445d535f3ad08ad") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "253f8c939e1924cd2f35bc30e37664fd4b281b2b") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "14325cc3fa9ef4eafb6e582684566fa85e6e6f25") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
