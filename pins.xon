; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "dff011c3c42b4c496d931a427820abd487177ddf") ; v0.34.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "35689516414a7c03017dca6fe36fe3d2868474fd") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "8a9c22e9e359f512cb24e57aab573b72ae90ef27") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "2965d139f42262a60224d9dc3e4254e184905652") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "dc81e4cb0e4c405b92cc21734bcb7b38c83cf1c3") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "dae5160905d08956563391a7cfe4d66ad586063b") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "371252ef91d1f322522a08a9f2cebadc9cf0c662") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "cc7044037a3cdfbc2481747ff6fbc858412e793b") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "9f33154a5155f5a5d00f6cf325711e2bb0f7f5ae") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "958555af09b1c823f4873f294d3823a5174ca833") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "a5933f47baa3fb67fc5d04daabb73a563b0394c4") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "3677cd004866e91468cb69b19212802ca2cc86b8") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "fa935575470ace1e5faeb59dd31c2bfab5d384b8") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
