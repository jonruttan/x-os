; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "d6910426b0194b615b43a7155b2791e4bde75828") ; v0.52.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "7abef84ddead413d113f2f8706a11dd74000413c") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "7de8ee149f05f1e5648fdb87f4bff6a6da1c6b6b") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "0f33eabe22c7a3e2d2010d861b98fe1c4e6fe52f") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "01dd00941cc60f76e43dfeb60e6155f753ec3919") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "9dd7285d2fbd607aa2969c0ab09f1446ead2bcd8") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "9a4975aeba06cf4b82899eeb509dce886462f82f") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "cbf772098feed187a50c9448eb719c602867f51e") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "97f23e27922ac837fd5aeb033ee5f5f8cbb9315c") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "566e00e33e018fbf1692ce2cc419e4bdccfa57e7") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "b66b873ec3223ee9f88b423ee260aa38d77ea8d9") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "7e6891e53055d81a3f1235121696d32f85fff5e8") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "d77b35e9e820ab49c23412a86cdacaf9cba97cd7") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "fde0375d79ea1c5388fed5f03ff95db2d87915fe") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "ba69ba7f7e91581b7f8ee10dc819b8f008da9a4d") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "37bf37ad8ad395ddeb77ae4ed568b4c011e67ea5") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "9c64ca956311b2dd642cec1444fda55bbd88e085") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
