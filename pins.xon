; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "79eb568ebe6eb975ed5547cc144d20d5dc5eac14") ; v0.37.1
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "baa0e923e466fe72217783229e39aa0aa035cf83") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "a87dc917eeb5d028db6f0b53975e2a73b93b4050") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "f1b71e2c3d51758b75258b295140df017e554d45") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "62882fd8482c93954bad18818b1be4dedd4bc4e2") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "bfc5a6ffe94b51370dbff3913d8046f30a17e9bc") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "33fe2b65de7b3774fec9c73346a9f8242b75b984") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "4e14d53a45c8a4d5b59d0d785dcd6857938ee382") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "30988ab2bbf6b7acbaf526f201a02dee4591a9c0") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "aa18b7816465ce8b1990b9574c41b1761bed70f4") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "a5933f47baa3fb67fc5d04daabb73a563b0394c4") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "f2e4dfc221983540b1e7abe157cb2ed5e3464118") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "d4222e456097e10b9b2834581616f42b41579f9b") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "5c3b8899dd1752b106292ec682696e3136f72f09") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
