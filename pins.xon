; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "28ff339b491b3681d889f9f79985fc5a750f59ac") ; v0.51.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "81bf6545d54e05da6efb67e4b46a2ce1fb292004") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "4a0e3dc73edd9a984b0ba4316b41f895fb8ef9f9") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "409436923f5191fc4840066502ef51f39ee7e90c") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "d56eb5c43337dea4096a8dab3d330b891a2c5af9") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "c4bcf3d5d2779e84893a9b6b9f9d9dccf94aa7b4") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "28ecdeaf012a6f1de214139081db40b1b3da8aad") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "77e701020cd3b55da4cba0bf0d8d56e7e2f15a79") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "b0ac1ee091cdf81f1391d8ab549fdb0ecd80e817") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "2d319b7de1b0bcef64b4c9ce6151e5c2c9889242") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "03794ebe5c475617d7b9261b7fe68668e28b76b0") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "f5706061238ea653efa9ce3ec3a408fe4f7b190e") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "5bfce11450e4f5f72ded155e0dc4a0c2f77792a0") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "cda33828d47217ed7acc1d0950c59dcd2c9878f3") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "0c73ddebac1fc9a4b280b5df3cef7ece0bb2f130") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "083f1deca989e6aec145d0e836004f1301060d49") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "3bf7b60ad9c9f61130854f14ace40a277f4f6dc0") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
