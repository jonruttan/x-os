; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "3da43d8a2aabc8732025dd8103bee87452adc989") ; v0.53.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "8421aa7d65164c2cb1ce72b50cc781b5a211d337") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "ca4ba1b8450eb983802b01ae0dae3653f812ac68") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "9ec6d6774f92ec57cd449dcc23f0636638991f30") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "dc87991b05a36bb55cf1dda14e8da74865a3e804") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "f42aada3b954403bc83174fcc27510bd3a984652") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "65d0af0dfb7590474d1b67bb3d5ce813e92d6cdb") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "7158d0b5b61f62547692ed32cc8b41b4bfba38d0") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "97f23e27922ac837fd5aeb033ee5f5f8cbb9315c") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "556130dbdac16b5ab4279e6c2ac73a89e26b36b0") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "b66b873ec3223ee9f88b423ee260aa38d77ea8d9") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "e03945a63a96b3d87bbc74e0a25accffd4fc1ade") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "3b41673ef9589831e790c34eae44046158b04393") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "3615a05282b020204bc856c17210f0fe52501e06") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "029ff14a7cf0a00a11534a1139ad39375f60711a") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "220131a4b10bdf20fcacf2f1de5741c499883ce5") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "3865b6e7548ceabe5f3c30443750049bf6d02f4e") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
