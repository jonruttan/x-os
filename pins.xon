; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "9e0b1d04b5efcac2eaa87d97a7f7cb58e322bed5") ; v0.16.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "2d86556cea4274a42b8203bf6ea998c3d447594e") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "750cc7e037995f5b5206a8cdec30c23b7d7d54bb") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "349e86ab1b259a13d7049e5e8a58a1070434d850") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "5aa59bef509a19511d5c6ccd70e5e2f3c8334842") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "31772307f46bf7e5a56134dc806f1fc35b72b86b") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "e8ccd8b8ee4601992eb42f07b48105127c48442c") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "164450922f6087f8410766772c11b09f76b25eaf") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "5977e08cbbb1f195b22fcc8b727cb818fb3bc0b7") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
