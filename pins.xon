; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "8affe65025c0191de8582eeca49a34cc6dcbf7d5") ; v0.28.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "d35aed0e0dd75bfa0efc7dbb63fe4be95a0c8ec6") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "ef4cb86f6f3733c1c4f76ddca6e040a933789e0a") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "81ebe242e6610efb9d75273e9a7ca11650dd31c8") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "539ea3e09651322256aef82736dd981fdbf70e20") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "48a01e9ee944275a8087c7ec8ce86b9656e85b2d") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "cb537acc9ca81c2836082367138fd39c58342eba") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "8ab5b0399a0ea0911d0ca3b4db0dd9cf87308dd0") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "c681fb735ba7858e64dbb3b830099c74d9b9f6a0") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "893b0d38efc1d2f45b94d76bd309a193bbaad1e4") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "08f3f6c9a6be9dd34f525561fa4783bf9ff6b481") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
