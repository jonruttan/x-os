; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "e9f4b531de0864456ac8fd73b790470a530fcbc9") ; v0.46.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "9c11bdd086fcb86b8ef6cbbad2e38010df8a92b7") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "b89c89be9557c5f28e910c94ae7a6d56c5183599") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "c5f16e27e83b355f52f82dd323c9b2ed210e6b34") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "2f0d1df030f48f3e970aeec0c7113b4a4eca8c95") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "d335336e9357813ffc41cfe0f33ec672cb6a3e33") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "0fa08e77970edfb186adae2ddae3df6aa5c10c2b") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "27cb5d79e4e934402d71d3a6aabe227ac7f3d380") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "602aa27002edddf1cf3c80a1da04fab8f3207bb7") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "4e429e53f89008beb869280d90e1b22c711e2881") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "7c1b3ae727c224b734c5b67bb650064fe75fa98b") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "3cb8425e37f9f8fc11c9e8b4a80c763ba36a4030") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "5e50c099ced1ec6599384cb97c5d7637fc99630e") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "b0ac17c2c627f5499853093d62f39dc3aa4e733e") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "f330a4f211828cc5b9578ecf0bf59eda1eba5f65") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "34ccd1cd0771ba18a92037157319dac3dc0ee94d") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "c832aaedf405c1497b3687aa6020a4dd3b5cc719") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
