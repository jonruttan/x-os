; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "97ed33e439bd6a118ddcbf1ca9517067b33b494f") ; v0.41.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "30a5b960c3b7221a81944e917249613ed58f5979") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "8b49d7ade17fe916d56983802c9a82f00be19d16") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "ef1c7808522b54527a388f3944a9fd51d5000fa2") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "332b5e3f361f86f5e95ef4e6bfa4e80148df6ae5") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "1f689b51bd9ebd0d7af050faa006397835f0d9c7") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "8694971a95a9000d43d23161ab07eba4a18eadcd") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "38bc5ac38df49dfb41e58eb883438636ada0966e") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "a53756c6be43f3365bc22ee2cb57bf700ad109a8") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "9246146cee3f912faf259d24f5f339f0cbddf516") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "ad3f5f93089e90807b5bc07a7587d94e9312ea39") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "44bb80b3855caa1d11781444048a03b005a1482a") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "53fdad6b80d8d357429ccb36a39094cbadb313a5") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "7b7d4c4165463b1d1d1729c8da83678f95582cf5") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "4f984941157a77071f99b6093ea7821283e3ad41") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
