; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "e1fd08b1cf4d6e02f83bae326faa1301857361ec") ; v0.18.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "2f81108670cf159f2163c9036b5b5807e5539ec3") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "8326d4a4a92b2e8fa4ef22a5beeb7958009e80b3") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "3f51fcf2e63adeff7834c5d69b1139a3df61cb82") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "d56c20a797ad066caa0a2e63b3735a795b9b5812") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "672071a1f2e9e623cdcccaf64638c6001e850f54") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "5f54471f07404a02bc7d919d1168e648a9311720") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "2ea5209a00f75340125024f8a35ae0e730d8c303") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "750ac751e208ffd7670bd9bb6c6543331cb0bb94") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "77c2b52c90953600551874c7d079040436053277") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
