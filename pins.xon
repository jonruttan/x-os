; pins.xon -- what the image is built from.
;
; (source NAME URL COMMIT) is a pin: the commit is the whole of it, and
; tools/fetch.sh refuses a checkout whose commit is not the one named.  The
; comment after a row says where the commit was found and decides nothing.
;
; (track NAME WHAT) says where tools/pins-update.sh looks for a newer commit:
; `release` is the highest version tag, `main` the head of the main branch.
; Tracking moves nothing by itself; a moved pin arrives as a pull request.
;
; Both tools read this file as text, a row a line.

(source x-lang      "https://github.com/jonruttan/x-lang.git"      "634abc6c456c1cca43b1f3e0ec6a0308b369a382") ; v0.62.0
(source x-ash       "https://github.com/jonruttan/x-ash.git"       "9b6d4fee477aac4335ad74674db2ebde2b1d12d1") ; main
(source x-coreutils "https://github.com/jonruttan/x-coreutils.git" "fc107b21fa73e7f21bce28fa9e32836161387f61") ; main
(source x-grep      "https://github.com/jonruttan/x-grep.git" "f0ec4dba038a78454b03747f748725c392e51e2b") ; main
(source x-sed       "https://github.com/jonruttan/x-sed.git" "2c3b65e7d438180f19230a24e731bedad57a0bdd") ; main
(source x-awk       "https://github.com/jonruttan/x-awk.git" "ecf33d20b1094fe1336aebc79f9576ee95e6c46a") ; main
(source x-cc        "https://github.com/jonruttan/x-cc.git" "3f2a2406011caa31466b44fb76cfc44c67c13fcb") ; main
(source x-python    "https://github.com/jonruttan/x-python.git" "ed96e54c80af02cf92b252a5ae44d845ebbf1f85") ; main
(source x-logo      "https://github.com/jonruttan/x-logo.git" "dcd8d14a16fd0a01503fb6522bb5e9161a1c7030") ; main
(source x-make      "https://github.com/jonruttan/x-make.git" "227184ceadc498a7b6399b157c957aa90f33e959") ; main
(source x-infocom   "https://github.com/jonruttan/x-infocom.git" "123308f12dad03ee238e53f49f97568c590eb3b6") ; main
(source x-ssh       "https://github.com/jonruttan/x-ssh.git" "2123f1ff0e4159d8fb79e4976a06a9b30393602f") ; main
(source x-git       "https://github.com/jonruttan/x-git.git" "2bc481502f0730b716d6f226e10c8728cc931623") ; main
(source x-tmux      "https://github.com/jonruttan/x-tmux.git" "689c9ee1117775197eece9ec2d0688ec21823467") ; main
(source x-browse    "https://github.com/jonruttan/x-browse.git" "ddcd2ba3f924dbd56a88ff77d62f50912682fbd3") ; main
(source x-chess     "https://github.com/jonruttan/x-chess.git" "70a255e36df3fda5658358be3640627bed84b3f0") ; main
(source x-roguelike "https://github.com/jonruttan/x-roguelike.git" "59c5dbd3befb51589ea5c312dce79a8330757002") ; main
(source x-doc       "https://github.com/jonruttan/x-doc.git" "66ced13de344e49abd52a7a51bb1be1c9a76c279") ; main

(track x-lang      release)
(track x-ash       main)
(track x-coreutils main)
(track x-grep      main)
(track x-sed       main)
(track x-awk       main)
(track x-cc        main)
(track x-python    main)
(track x-logo      main)
(track x-make      main)
(track x-infocom   main)
(track x-ssh       main)
(track x-git       main)
(track x-tmux      main)
(track x-browse    main)
(track x-chess     main)
(track x-roguelike main)
(track x-doc       main)
