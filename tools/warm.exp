#!/usr/bin/expect -f
# warm.exp -- run the shell and an x session at a terminal, so that the code
# each compiles for its first prompt is in the cache X_ASM_CACHE_DIR names.
#
#   expect warm.exp BIN
#
# BIN holds sh and x, each a link to the launcher.  The line editors compile
# their painters at the first prompt they draw, and a container starts with
# an empty cache, so a cache filled here is one the image is built with.

set timeout 600
set bin [lindex $argv 0]
if {$bin eq ""} {
	puts stderr "usage: warm.exp BIN"
	exit 2
}
set env(PATH) "$bin:/usr/bin:/bin"
set env(TERM) xterm

proc fail {what} {
	puts stderr "\nwarm: $what"
	exit 1
}

proc await {pattern what} {
	expect {
		-re $pattern {
		}
		timeout {
			fail "no $what"
		}
		eof {
			fail "the session ended waiting for $what"
		}
	}
}

spawn $bin/sh
await {\x1b\[K# } "shell prompt"
send "echo warm\r"
await "\nwarm\r" "answer from the shell"
await {\x1b\[K# } "shell prompt after echo"
send "x\r"
await {\x1b\[K> } "prompt from x"
send "(write 1)\r"
await "\n1\r" "answer from x"
await {\x1b\[K> } "prompt from x after its answer"
# The TLS client's engines -- X25519, SHA-256, ChaCha20, Poly1305, SHA-512,
# the base64 decoder and the Montgomery runner -- which connect builds
# before it dials: a fresh container with an empty cache compiled them for
# a quarter of a minute while the server waited, and Cloudflare closes the
# connection first.  Each jit! answers #t when its engine is compiled.
# (Tls13 ready!) says the same in one call from x-lang v0.31.0 on.
# The lines are short: the editor redraws the line a character at a time.
foreach module {x/net/tls13 x/codec/x25519 x/codec/sha256 x/codec/sha512 x/codec/chacha20 x/codec/poly1305 x/codec/base64} {
	send "(import $module)\r"
	await {\x1b\[K> } "prompt from x after importing $module"
}
send "(import x/codec/mont-jit mont-jit-ready!)\r"
await {\x1b\[K> } "prompt from x after importing mont-jit"
send "(write (list (X25519 jit!) (Sha256 jit!) (ChaCha20 jit!)))\r"
await "\n\\(#t #t #t\\)\r" "the X25519, SHA-256 and ChaCha20 engines"
await {\x1b\[K> } "prompt from x after three engines"
send "(write (list (Poly1305 jit!) (Sha512 jit!) (Base64 jit!)))\r"
await "\n\\(#t #t #t\\)\r" "the Poly1305, SHA-512 and base64 engines"
await {\x1b\[K> } "prompt from x after six engines"
send "(write (mont-jit-ready!))\r"
await "\n#t\r" "the Montgomery runner"
await {\x1b\[K> } "prompt from x after the engines"
send "\004"
await {\x1b\[K# } "shell prompt after x"
# x-tmux's screen engine, compiled and proven as a session starts: a pane
# drawn by the reference engine until it is, and seven seconds to build.
send "x -l tmux\r"
await {\x1b\[Ktmux> } "prompt from x-tmux"
send "(write (vt-jit!))\r"
await "\n#t\r" "x-tmux's compiled screen"
await {\x1b\[Ktmux> } "prompt from x-tmux after its engine"
send "\004"
await {\x1b\[K# } "shell prompt after x-tmux"
send "exit\r"
expect eof
puts "\nwarm: the shell and x drew their prompts"
