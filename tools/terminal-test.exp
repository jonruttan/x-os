#!/usr/bin/expect -f
# terminal-test.exp -- use the container's shell at a terminal, as a person
# would: wait for the prompt, type, read the answer.
#
#   expect tools/terminal-test.exp IMAGE PLATFORM
#
# CONTAINER names the container command, docker when it is not set.
#
# container-test.sh pipes a script in and never meets the line editor; this
# does.  Nothing is typed until the prompt it goes to has been drawn: a line
# editor setting up its terminal discards what was typed ahead of it.
#
# Set TERMINAL_LOG to a path to keep the session's transcript.

set timeout 120
if {[info exists env(TERMINAL_LOG)]} {
	log_file -noappend $env(TERMINAL_LOG)
}
set image [lindex $argv 0]
set platform [lindex $argv 1]
if {$image eq "" || $platform eq ""} {
	puts stderr "usage: terminal-test.exp IMAGE PLATFORM"
	exit 2
}

# A prompt as the line editors draw it: the line cleared, then the prompt.
set shell_prompt {\x1b\[K# }
set x_prompt {\x1b\[K> }
set logo_prompt {\n\? $}
# An empty line of vi's screen: the cursor put at a row's start, then a tilde.
set vi_empty_line {\x1b\[[0-9]+;1H~}
# A prompt in a tmux pane, as x-tmux redraws the row: the cursor put at
# the pane's left edge, the attributes reset, then the prompt.
set pane_prompt {\x1b\[[0-9]+;[0-9]+H\x1b\[0m# }
# tmux's status line: the shown window starts with attributes that include
# underscore (4), and the next attributes end it.  The status line's colours
# are in both, so neither is matched exactly.
set shown_on {\x1b\[(?:[0-9]+;)*4(?:;[0-9]+)*m}
set attrs {\x1b\[[0-9;]*m}

# A status line pattern from its pieces: status PIECE...
proc status {args} {
	return [join $args ""]
}

proc fail {what} {
	puts stderr "\nterminal-test: $what"
	exit 1
}

# Wait for output matching a pattern: await PATTERN WHAT
proc await {pattern what} {
	expect {
		-re $pattern {
		}
		timeout {
			fail "no $what"
		}
		eof {
			fail "the container ended waiting for $what"
		}
	}
}

# An answer is a line of its own, not the echo of what was typed.
proc await_line {text what} {
	await "\n$text\r" $what
}

set container docker
if {[info exists env(CONTAINER)] && $env(CONTAINER) ne ""} {
	set container $env(CONTAINER)
}
spawn $container run --rm -it --platform $platform --memory 3g --pids-limit 256 $image

await "exit or ctrl-d to leave" "shell banner"
await $shell_prompt "shell prompt"
send "echo typed-\$((6*7))\r"
await_line "typed-42" "answer to echo"

await $shell_prompt "shell prompt after echo"
send "uname -m\r"
await_line "(x86_64|aarch64)" "answer to uname"

await $shell_prompt "shell prompt after uname"
send "x\r"
await "ctrl-d to exit" "banner from x"
await $x_prompt "prompt from x"
send "(write (+ 40 2))\r"
await_line "42" "answer from x"

await $x_prompt "prompt from x after its answer"
send "\004"
await $shell_prompt "shell prompt after x's session"
send "echo back-from-x\r"
await_line "back-from-x" "answer from the shell after x's session"

await $shell_prompt "shell prompt before logo"
send "logo\r"
await $logo_prompt "prompt from logo"
send "print 19*53\r"
await_line "1007" "answer from logo"

await $logo_prompt "prompt from logo after its answer"
send "\004"
await $shell_prompt "shell prompt after logo's session"
send "echo back-from-logo\r"
await_line "back-from-logo" "answer from the shell after logo's session"

# vi: a line is put in, the file written, and the shell reads it back.  The
# pause lets vi tell the escape key from the start of a key's sequence.
await $shell_prompt "shell prompt before vi"
send "vi /tmp/note.txt\r"
await $vi_empty_line "screen from vi"
send "iwritten-in-vi"
await "written-in-vi" "the line in vi"
send "\033"
sleep 1
send ":wq\r"
await $shell_prompt "shell prompt after vi"
send "cat /tmp/note.txt\r"
await_line "written-in-vi" "the file vi wrote"

# vi's syntax option with a bundle's grammar: :set sy draws a shell script
# in the colours of x-ash's sh grammar, found by the file's suffix, its if a
# keyword in the default theme's bold magenta.
await $shell_prompt "shell prompt before vi's syntax"
send "printf 'if true; then echo hi; fi\\n' > /tmp/colour.sh\r"
await $shell_prompt "shell prompt after the script is written"
send "vi /tmp/colour.sh\r"
await $vi_empty_line "screen from vi on the script"
send ":set sy\r"
await {\x1b\[1;35mif\x1b\[0m} "if drawn as a keyword by the sh grammar"
send ":q\r"
await $shell_prompt "shell prompt after vi's syntax"
send "echo back-from-vi\r"
await_line "back-from-vi" "answer from the shell after vi's syntax"

# The same with x-make's grammar, found by the name Makefile: its ifdef a
# directive, drawn as a keyword.
await $shell_prompt "shell prompt before vi on a Makefile"
send "printf 'ifdef DEBUG\\nendif\\n' > /tmp/Makefile\r"
await $shell_prompt "shell prompt after the Makefile is written"
send "vi /tmp/Makefile\r"
await $vi_empty_line "screen from vi on the Makefile"
send ":set sy\r"
await {\x1b\[1;35mifdef\x1b\[0m} "ifdef drawn as a keyword by the make grammar"
send ":q\r"
await $shell_prompt "shell prompt after vi on the Makefile"
send "echo back-from-make-vi\r"
await_line "back-from-make-vi" "answer from the shell after vi on the Makefile"

# browse: a page in the browser, its heading drawn, and q back to the
# shell.  The heading is spelled out by printf so that the command's echo
# is not what matches.
await $shell_prompt "shell prompt before browse"
send "printf '# Browse%s\\n\\nA line.\\n' page > /tmp/term.md\r"
await $shell_prompt "shell prompt after the page is written"
send "browse /tmp/term.md\r"
await "Browsepage" "the page's heading in browse"
send "q"
await $shell_prompt "shell prompt after browse"
send "echo back-from-browse\r"
await_line "back-from-browse" "answer from the shell after browse"

# chess: a game at the terminal, a move and the engine's reply, and quit
# back to the shell.
await $shell_prompt "shell prompt before chess"
send "chess --depth 1\r"
await "White to move" "the board and whose move it is in chess"
send "e4\r"
await "x-chess plays Nf6" "the engine's reply in chess"
send "quit\r"
await $shell_prompt "shell prompt after chess"
send "echo back-from-chess\r"
await_line "back-from-chess" "answer from the shell after chess"

# roguelike: a game at the terminal, its standing drawn, Q asked and
# answered, the final screen dismissed, and the shell back.
await $shell_prompt "shell prompt before roguelike"
send "roguelike -seed 3\r"
await "Level:1" "the standing row in roguelike"
send "Q"
await "Really quit?" "the question in roguelike"
send "y"
await "any key" "the final screen in roguelike"
send " "
await $shell_prompt "shell prompt after roguelike"
send "echo back-from-roguelike\r"
await_line "back-from-roguelike" "answer from the shell after roguelike"

# tmux: a session's status line, a command in its pane, a split and a
# command in the new pane, C-b d back to the shell with the server still
# running, ls and attach to it, copy mode and out of it, a second window
# and back to the first, the first renamed with C-b , the left pane picked
# with C-b Left and zoomed with C-b z and back, the panes' numbers shown
# with C-b q and 0 picking the left pane again, an answer copied
# in copy mode (emacs's keys: no EDITOR names vi) and C-b ] pasting it
# into a sum whose answer only the paste makes, and ls counting both,
# then kill-server so no server outlives the test.  A window is named
# after its program, so a name matches whatever it is.
await $shell_prompt "shell prompt before tmux"
send "tmux\r"
await [status {\[0\] } $shown_on {0:[^ \x1b]*\*}] "tmux's status line"
await $pane_prompt "the first pane's prompt"
send "echo in-a-pane-\$((6*7))\r"
await "in-a-pane-42" "answer in the first pane"
send "\002%"
await "│" "the border of a split"
await $pane_prompt "the second pane's prompt"
send "echo right-pane-\$((6*7))\r"
await "right-pane-42" "answer in the second pane"
send "\002d"
await {\[detached \(from session 0\)\]} "tmux's detach line"
await $shell_prompt "shell prompt after tmux"
send "echo back-from-tmux\r"
await_line "back-from-tmux" "answer from the shell after tmux"
await $shell_prompt "shell prompt before tmux ls"
send "tmux ls\r"
await {0: 1 windows \(created } "the session tmux ls lists"
await $shell_prompt "shell prompt before tmux attach"
send "tmux attach\r"
await "right-pane-42" "the session's panes again after attach"
send "\002\["
await {\[0/[0-9]+\]} "copy mode's position"
send "q"
sleep 1
send "\002c"
await [status {0:[^ \x1b]*- } $shown_on {1:[^ \x1b]*\*}] "a second window on the status line"
await $pane_prompt "the second window's prompt"
send "\0020"
await [status $shown_on {0:[^ \x1b]*\*} $attrs { 1:[^ \x1b]*-}] "the first window shown again"
await "right-pane-42" "the first window's panes"
send "\002,"
await {\(rename-window\) } "C-b ,'s prompt"
send "\025work\r"
await [status $shown_on {0:work\*}] "the first window renamed"
send "\002\033\[D"
send "\002z"
await [status $shown_on {0:work\*Z}] "the window zoomed"
await "in-a-pane-42" "the left pane, picked by C-b Left, over the window"
send "\002z"
await [status $shown_on {0:work\*} $attrs] "the window unzoomed"
send "\002q"
await {\x1b\[0;31m[0-9]+x[0-9]+} "the active pane's size, shown red by C-b q"
send "0"
send "\002:"
send "renamew cmd\r"
await [status $shown_on {0:cmd\*}] "the window renamed by C-b :'s command"
send "\002:"
send "bind -n M-z renamew zed\r"
send "\033z"
await [status $shown_on {0:zed\*}] "the window renamed by a key bound with bind -n"
send "echo \$((20+1))\r"
await {\x1b\[0m21 } "the answer to copy"
await $pane_prompt "the prompt after it"
send "\002\["
await {\[0/[0-9]+\]} "copy mode's position before a selection"
send "\033\[A\001"
send -null
send "\005\033w"
sleep 1
send "echo pasted-\$((2*"
send "\002\]"
send "))\r"
await "pasted-42" "the answer the paste made"
send "\002d"
await {\[detached \(from session 0\)\]} "tmux's detach line after attach"
await $shell_prompt "shell prompt before tmux ls of two windows"
send "tmux ls\r"
await {0: 2 windows \(created } "tmux ls counting the windows"
await $shell_prompt "shell prompt before kill-server"
send "tmux kill-server\r"
await $shell_prompt "shell prompt after kill-server"
send "tmux ls\r"
await "no server running on" "tmux ls after kill-server"

await $shell_prompt "shell prompt before exit"
send "exit\r"
expect {
	eof {
	}
	timeout {
		fail "the shell did not leave at exit"
	}
}
puts "\nterminal-test: $platform answered at a terminal"
